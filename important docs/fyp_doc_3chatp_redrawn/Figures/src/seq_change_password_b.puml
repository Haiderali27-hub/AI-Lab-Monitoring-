@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 220
hide footbox
hide unlinked
skinparam ParticipantPadding 4
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Backend_API/Controllers/AuthController.cs (ChangePassword);
' Services/RefreshTokenService.cs (RevokeOtherSessionsAsync); Helpers/PasswordHelper.cs.

actor "Staff user" as U
participant "Navbar\n(web panel)" as UI
participant "AuthController" as AC
participant "RefreshToken\nService" as RT
participant "PasswordHelper" as PH
database "AppDbContext" as DB
activate UI
activate AC
AC -> RT : revoke other sessions
activate RT
RT -> DB : revoke other token\nfamilies and sessions
RT --> AC : revoked counts
deactivate RT
AC -> PH : new salt and hash
activate PH
PH --> AC : PBKDF2 hash\n(600,000 iterations)
deactivate PH
AC -> DB : save salt and hash;\naudit PASSWORD_CHANGED
AC --> UI : 200 password updated
deactivate AC
UI --> U : success message
deactivate UI
note over UI, DB : The caller's own session and token family stay valid.
@enduml

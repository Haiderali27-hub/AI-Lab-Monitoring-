@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 6
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' User and role management (Module 7, UC-23 with UC-27's guard), part (d): force logout.
' Code: Admin_Web_Panel/src/pages/admin/UsersPage.tsx (handleForceLogout; also DeviceBindingsPage.tsx),
' src/api/users.api.ts (usersApi.forceLogout);
' Backend_API/Controllers/UsersController.cs (ForceLogout, GuardExistingAsync);
' Services/RefreshTokenService.cs (RevokeAllForUserAsync); Services/ExamGroupTracker.cs (RevokeAsync);
' Services/AuditService.cs (Add, LogAsync).

actor "Admin /\nSuperAdmin" as A
participant "Users\npage (web)" as UI
participant "Users\nController" as UC
participant "RefreshToken\nService" as RT
participant "ExamGroup\nTracker" as EG
participant "Audit\nService" as AS
database "AppDbContext" as DB

A -> UI : force logout
activate UI
UI -> UC : force logout
activate UC
UC -> UC : may the caller\nact on this user?
break target is Admin / SuperAdmin,\ncaller not SuperAdmin
  UC -> AS : log denial
  activate AS
  AS -> DB : save PRIVILEGED_\nACCOUNT_DENIED
  AS --> UC
  deactivate AS
  UC --> UI : refused
end
UC -> RT : revoke all tokens
activate RT
RT -> DB : revoke refresh\ntokens
RT --> UC : count
deactivate RT
UC -> DB : revoke open\nsessions
UC -> AS : FORCE_LOGOUT
activate AS
AS -> DB : add audit row
deactivate AS
UC -> DB : save
UC -> EG : drop user from\nlive-monitor groups
activate EG
EG --> UC : done
deactivate EG
UC --> UI : "Revoked N\nsession(s)"
deactivate UC
UI --> A : "Active sessions\nrevoked."
deactivate UI
@enduml

@startuml
' UML 2.5 use case diagram, figure (b): the staff use cases of the web panel. Figure (a), the student's
' use cases and live supervision (UC-01 to UC-14), is use_case_diagram.puml.
' Every use case carries its ID (UC-nn, as in Chapter 4); the UC-to-FR mapping is given in the text.
!include style.iuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 8
skinparam ranksep 34
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam usecase {
  FontSize 14
}
skinparam actor {
  FontSize 14
}
skinparam rectangle {
  FontSize 14
}

actor "Email\nserver" as SMTP <<system>>
actor "Invigilator" as INV
actor "Teacher" as TEA
actor "Admin" as ADM
actor "SuperAdmin" as SUP

rectangle "SmartExam" {
  rectangle "Web panel" as WEB {
    usecase "UC-12 Web\nsign-in" as U12
    usecase "UC-13 Create and\nconfigure exam" as U14
    usecase "UC-19 Send exam\nnotifications" as U15
    usecase "UC-20 Set\neligibility" as U16
    usecase "UC-15 Assign seats\nand invigilators" as U17
    usecase "UC-16 Review\nsuggested marks" as U18
    usecase "UC-17 Review\nsimilarity matrix" as U19
    usecase "UC-18 Export\nreports" as U20
    usecase "UC-23 Manage\nusers and roles" as U21
    usecase "UC-24 Manage\ndepartments, courses" as U22
    usecase "UC-25 Reset\ndevice binding" as U23
    usecase "UC-26 Register\nlabs and PCs" as U24
    usecase "UC-21 Verify\naudit log" as U25
    usecase "UC-22 View\nsystem analytics" as U26
    usecase "UC-27 Manage\nadmin accounts" as U27
  }
}

U12 -- INV

U14 -- TEA
U15 -- TEA
U16 -- TEA
U17 -- TEA
U18 -- TEA
U19 -- TEA
U20 -- TEA
SMTP --- U15

U21 -- ADM
U22 -- ADM
U23 -- ADM
U24 -- ADM
U25 -- ADM
U26 -- ADM

U27 -- SUP

INV <|-right- TEA
TEA <|-right- ADM
ADM <|-right- SUP
@enduml

@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
hide footbox
hide unlinked
skinparam ParticipantPadding 2
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Services/Grading/GradingQueue.cs (GradingQueue, GradingWorker), GradingService.cs (ProcessAsync, GradeCodeAsync),
' CodeRunnerResolver.cs, DockerCodeRunner.cs, LocalMingwCodeRunner.cs, TestCaseScorer.cs, CodeAnalyzer.cs.
' The submit side (StageAsync, Enqueue, receipt) is drawn in seq_ai_plagiarism.puml.
' Open arrowheads (->>) are one-way: Enqueue writes the id to an unbounded channel, and GradingCompleted is
' IHubContext<MonitoringHub>.Clients.Group("exam:{id}").SendAsync(...).

participant "GradingQueue" as GQ
participant "GradingWorker\n(2 in parallel)" as GW
participant "GradingService" as GS
database "AppDbContext" as DB

loop each queued coding answer
  GQ ->> GW : answer id
  activate GW
  GW -> GS : grade answer
  activate GS
  GS -> DB : load result row,\nanswer, test cases
  DB --> GS : row
  break row missing or\nnot pending
    GS --> GW : skip
  end
  GS -> GS : choose runner:\nDocker, else MinGW,\nelse none
end
@enduml

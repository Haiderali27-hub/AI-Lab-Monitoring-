@startuml
!include style.iuml
' Part (b): reports, process 5.5. 5.1-5.4 are in dfd_level_2b.puml (part a), 5.6 in dfd_level_2c_services.puml (part c).
' DFD level 2 of process 5.0 (Evaluation and reporting). Process 3.0 is in
' dfd_level_2.puml. Same entities, numbers and stores (D1..D8) as level 1.
' Yourdon/DeMarco notation: circle = process, rectangle = external entity,
' two lines = data store, dashed circle = level-1 process outside 5.0,
' dashed rectangle = optional entity, * = store or entity drawn twice.
skinparam defaultFontSize 16
skinparam ArrowFontSize 16
skinparam nodesep 18
skinparam ranksep 40
skinparam defaultTextAlignment center
skinparam rectangle<<entity>> {
  BorderThickness 2
  RoundCorner 0
  BackgroundColor #FFFFFF
}
skinparam rectangle<<optional>> {
  RoundCorner 0
  BorderStyle dashed
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BorderColor #333333
  BorderThickness 2
  BackgroundColor #F2F2F2
}
skinparam usecase<<ref>> {
  BorderStyle dashed
  BorderThickness 1
  BackgroundColor #FFFFFF
}
skinparam label {
  FontSize 16
}
hide stereotype
top to bottom direction


label D3 [
----
**D3** Academic and
lab data
----
]
label D4 [
----
**D4** Sessions and
answers
----
]
label D6 [
----
**D6** Grading and
reports
----
]
label D5 [
----
**D5** Monitoring
evidence
----
]
label D8 [
----
**D8** Audit log
----
]
usecase "**5.5**\nBuild reports\nand exports" as P55
rectangle "Teacher" <<entity>> as TEA

D3 --> P55 : attendance
D4 --> P55 : sessions
D6 --> P55 : marks
D6 <-- P55 : report list
D5 --> P55 : evidence
D8 --> P55 : audit extract
D8 <-- P55 : report events
P55 --> TEA : PDF, Excel,\nZIP
P55 <-- TEA : report request
@enduml

@startuml
!include style.iuml
' DFD level 1, part (b): processes 4.0 and 5.0 (live proctoring, evaluation
' and reporting). Part (a) is dfd_level_1.puml (1.0-3.0). Same notation:
' circle = process, rectangle = external entity, two lines = data store
' (tables listed in the chapter text), two-headed arrow = read and update,
' dashed circle = process of part (a), dashed rectangle = optional entity,
' * = entity drawn twice.
' Portrait layout, short labels; the chapter text gives every flow in full.
skinparam defaultFontSize 16
skinparam ArrowFontSize 16
skinparam nodesep 6
skinparam ranksep 40
skinparam defaultTextAlignment center
skinparam rectangle<<entity>> {
  BorderThickness 2
  RoundCorner 0
  BackgroundColor #FFFFFF
}
skinparam rectangle<<optional>> {
  RoundCorner 0
  BorderStyle dashed
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BorderColor #333333
  BorderThickness 2
  BackgroundColor #F2F2F2
}
skinparam usecase<<ref>> {
  BorderStyle dashed
  BorderThickness 1
  BackgroundColor #FFFFFF
}
skinparam label {
  FontSize 16
}
hide stereotype
top to bottom direction

rectangle "Teacher" <<entity>> as TEA
rectangle "Invigilator" <<entity>> as INV
usecase "**3.0**\nLockdown and\ntelemetry (part a)" <<ref>> as P3
usecase "**4.0**\nLive\nproctoring" as P4

label D2 [
----
**D2** Exams
----
]
label D3 [
----
**D3** Academic and
lab data
----
]
label D4 [
----
**D4** Sessions and
answers
----
]
label D5 [
----
**D5** Monitoring
evidence
----
]
label D7 [
----
**D7** Notifications
----
]
label D8 [
----
**D8** Audit log
----
]

usecase "**2.0**\nConfigure exams and\nrun sessions (part a)" <<ref>> as P2
usecase "**5.0**\nEvaluation\nand reporting" as P5
rectangle "LLM grader\n(optional)" <<optional>> as LLM

label D6 [
----
**D6** Grading and
reports
----
]
rectangle "Teacher *" <<entity>> as TEA2
rectangle "Admin /\nSuperAdmin" <<entity>> as ADM
rectangle "Student" <<entity>> as STU

' ---- rank 0: staff and 3.0; rank 1: 4.0; rank 2: stores; rank 2 also 2.0; rank 3: 5.0;
' ---- rank 4: D6, LLM and the users of 5.0. "X <-- P" keeps X above P.
TEA --> P4 : proctor\nactions
TEA <-- P4 : live status,\ntimeline
INV --> P4 : proctor\nactions
INV <-- P4 : live status,\ntimeline
P3 --> P4 : live\nupdates

' ---- 4.0
P4 <-- D3 : proctor list
P4 --> D4 : extra time,\nunlock,\nforce-submit
P4 <-- D5 : timeline,\nscreenshots
P4 --> D5 : incidents
P4 --> D7 : warnings
P4 --> D8 : staff actions

' ---- 5.0
P2 --> P5 : submitted\nsession
D2 --> P5 : questions,\ntest cases
D3 --> P5 : attendance
D4 --> P5 : answers
D5 --> P5 : violations
D7 --> P5 : notifications
D8 --> P5 : audit log
D8 <-- P5 : grading and\nreport events
P5 ..> LLM : answers
P5 <.. LLM : suggested\nmark
P5 <--> D6 : marks,\nreports
P5 --> TEA2 : marks,\nreports
P5 <-- TEA2 : mark decisions,\nreport request
P5 --> ADM : audit log,\nanalytics
P5 --> STU : results
@enduml

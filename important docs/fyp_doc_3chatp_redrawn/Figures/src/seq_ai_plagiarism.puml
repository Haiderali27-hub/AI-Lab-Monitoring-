@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 220
hide footbox
hide unlinked
skinparam ParticipantPadding 4
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Backend_API/Controllers/ExamsController.cs (Submit); Services/SubmissionService.cs (FinalizeAsync);
' Services/Grading/GradingService.cs (StageAsync), TheoryGrader.cs.
' Background code grading of the queued answers: seq_compilation.puml. Teacher heat map: seq_plagiarism_matrix.puml.

participant "Submission\nService" as SS
participant "Grading\nService" as GS
participant "Plagiarism\nService" as PS
participant "Plagiarism\nEngine" as PE
database "AppDbContext" as DB

[-> SS : student submits exam
activate SS
SS -> DB : load session's answers
DB --> SS : answers
opt AI evaluation enabled for the exam
  SS -> GS : stage answers
  activate GS
  loop each answer not graded yet
    alt theory with LLM grader off,\nor blank theory answer
      GS -> GS : TF-IDF theory\ngrader
    else coding with a runner,\nor theory with LLM on
      GS -> GS : queue (Pending)
    else blank coding answer,\nor no runner set
      GS -> GS : grade at once\n(0 / not run)
    else MCQ
      GS -> GS : mark by\nchosen option
    end
    GS -> DB : add grading result
  end
  GS --> SS : answers to queue
  deactivate GS
end
@enduml

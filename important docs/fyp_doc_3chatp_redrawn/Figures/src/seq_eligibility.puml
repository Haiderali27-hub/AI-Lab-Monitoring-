@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 6
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Attendance import and eligibility (Module 9, UC-20), part (a): attendance import.
' Code: Admin_Web_Panel/src/pages/teacher/EligibilityPage.tsx (handleImport), src/api/exams.api.ts
' (examsApi.importAttendance -> multipart POST /api/sections/{sectionId}/attendance/import);
' Backend_API/Controllers/AttendanceController.cs (Import, AuthorizeSectionAsync, MaxUploadBytes = 1 MB);
' Services/AttendanceCsvParser.cs (Parse); Services/AuditService.cs (Add).

actor Teacher as T
participant "Eligibility\npage (web)" as UI
participant "Attendance\nController" as AC
participant "Attendance\nCsvParser" as P
participant "Audit\nService" as AS
database "AppDbContext" as DB

T -> UI : import\nattendance CSV
activate UI
UI -> AC : upload file
activate AC
AC -> DB : load section
break section missing\nor not own section
  AC --> UI : refused
end
break no file, or\nover 1 MB
  AC --> UI : error
end
AC -> P : parse CSV
activate P
P --> AC : rows, header error
deactivate P
break header error
  AC --> UI : error
end
AC -> DB : students, enrolments,\nattendance records
DB --> AC : rows
loop each row
  alt bad row, unknown or\ndeactivated student
    AC -> AC : add error\n(line, reason)
  else known student\n(warning if\nnot enrolled)
    AC -> DB : save total and\nattended classes
  end
end
AC -> AS : ATTENDANCE_\nIMPORTED
activate AS
AS -> DB : add audit row
deactivate AS
AC -> DB : save
AC --> UI : counts, errors,\nwarnings
deactivate AC
UI --> T : results\nby line
deactivate UI
@enduml

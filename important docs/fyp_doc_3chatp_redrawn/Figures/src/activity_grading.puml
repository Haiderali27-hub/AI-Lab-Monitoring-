@startuml
!include style.iuml
' AI-assisted grading (Module 11): SubmissionService.FinalizeAsync -> GradingService.StageAsync (when
' AiEvaluationEnabled): graded at once = MCQ key, TheoryGrader TF-IDF (LLM off), blank code (0, High),
' Grading:Runner = None (SetNotRun: 0, Low, CodeAnalyzer); otherwise a Pending row (coding: plus Pending test-case
' rows) that is queued; PlagiarismService.DetectAsync (PlagiarismEngine winnowing) unless IsMock; SaveChanges, then
' GradingQueue.Enqueue. GradingWorker (Grading:MaxParallel = 2 consumers, re-queues Pending rows on start) ->
' GradingService.ProcessAsync: Theory -> LlmGrader (TheoryGrader fallback); Coding -> CodeRunnerResolver
' (DockerCodeRunner gcc:13 or LocalMingwCodeRunner); no runner / not C or C++ -> SetNotRun; runner throws MaxAttempts
' = 3 times -> Failed; compile error -> 0, High (TestCaseScorer); else OutputComparer + TestCaseScorer; CodeAnalyzer on
' every coding path; audit AI_GRADING_COMPLETED / AI_GRADING_FAILED; hub GradingCompleted.
' Teacher, concurrently: POST /api/exams/{id}/grading/accept-ai (skips NeedsManualMark rows; Pending/Failed = notReady;
' audit AI_SUGGESTIONS_ACCEPTED), POST /api/answers/{id}/override (GRADE_OVERRIDDEN),
' POST /api/answers/{id}/regrade (AI_REGRADE_REQUESTED, back to the queue).
' Simplified labels: weights, k-gram settings, Docker limits and audit event names are in the chapter text.
' Large font at dpi 96. Printed pt = fontSize * printed_width_pt / png_width_px.
skinparam dpi 96
skinparam defaultFontSize 28
skinparam ArrowFontSize 27
skinparam padding 1
skinparam swimlane {
  BorderColor #777777
  TitleFontSize 29
}
|Server (API and GradingWorker)|
start
:Finalise the session
with a receipt;
if (AI evaluation\non?) then ([yes])
  if (Can mark\nat once?) then ([yes])
    :Mark now: MCQ by key,
    theory by TF-IDF
    if the LLM is off,
    blank or unrunnable
    code as 0;
  else ([no])
    :Queue the
    answer;
  endif
else ([no])
endif
if (Practice\nexam?) then ([no])
  :Plagiarism check
  (winnowing);
else ([yes])
endif
:Save, start the
queue;
fork
  while (Answer\nqueued?) is ([yes])
    if (Type?) then ([Theory])
      :LLM grader
      (TF-IDF
      fallback);
    else ([Coding])
      if (Runner and\nC/C++?) then ([no])
        :Not run, 0;
      else ([yes])
        :Run test cases
        (Docker or
        MinGW);
        switch (Result?)
        case ([failed])
          :Failed;
        case ([ran])
          :Score the
          test cases;
        case ([compile\nerror])
          :0, compiler
          output;
        endswitch
      endif
      :Code analysis;
    endif
    :Save result,
    audit, notify;
  endwhile ([no])
fork again
  |Teacher (ResultsPage)|
  repeat
    :Review marks,
    test cases,
    plagiarism;
    if (Action?) then ([accept\nall])
      :Accept ready
      suggestions;
    else ([one\nanswer])
      :Override
      or regrade;
    endif
  repeat while (More to\nreview?) is ([yes]) not ([no])
end fork
stop
@enduml

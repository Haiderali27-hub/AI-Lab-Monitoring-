@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 6
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' User and role management (Module 7, UC-23, UC-27), part (b): CSV import.
' Code: Admin_Web_Panel/src/pages/admin/UsersPage.tsx (handleCsvFile parses the CSV in the browser),
' src/api/users.api.ts (usersApi.importUsers -> POST /api/users/import {users});
' Backend_API/Controllers/UsersController.cs (Import); Services/AuditService.cs (Add).

actor "Admin /\nSuperAdmin" as A
participant "Users\npage (web)" as UI
participant "Users\nController" as UC
participant "Audit\nService" as AS
database "AppDbContext" as DB

A -> UI : upload CSV
activate UI
UI -> UI : read CSV rows
break no header or no rows
  UI --> A : alert (nothing sent)
end
UI -> UC : import rows
activate UC
UC -> DB : existing emails\nand roll numbers
DB --> UC : lists
loop each row
  alt invalid, duplicate\nor not allowed
    UC -> UC : skip row\n(line, reason)
  else valid row
    UC -> DB : add user\n(hashed password)
  end
end
UC -> AS : USERS_IMPORTED
activate AS
AS -> DB : add audit row
deactivate AS
UC -> DB : save
UC --> UI : created, skipped
deactivate UC
UI --> A : "N created,\nM skipped"
deactivate UI
@enduml

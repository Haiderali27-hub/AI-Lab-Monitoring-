@startuml
!include style.iuml
' Part (c): read-only services, process 5.6. 5.1-5.4 are in dfd_level_2b.puml (part a), 5.5 in dfd_level_2b_reports.puml (part b).
' DFD level 2 of process 5.0 (Evaluation and reporting). Process 3.0 is in
' dfd_level_2.puml. Same entities, numbers and stores (D1..D8) as level 1.
' Yourdon/DeMarco notation: circle = process, rectangle = external entity,
' two lines = data store, dashed circle = level-1 process outside 5.0,
' dashed rectangle = optional entity, * = store or entity drawn twice.
skinparam defaultFontSize 16
skinparam ArrowFontSize 16
skinparam nodesep 18
skinparam ranksep 40
skinparam defaultTextAlignment center
skinparam rectangle<<entity>> {
  BorderThickness 2
  RoundCorner 0
  BackgroundColor #FFFFFF
}
skinparam rectangle<<optional>> {
  RoundCorner 0
  BorderStyle dashed
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BorderColor #333333
  BorderThickness 2
  BackgroundColor #F2F2F2
}
skinparam usecase<<ref>> {
  BorderStyle dashed
  BorderThickness 1
  BackgroundColor #FFFFFF
}
skinparam label {
  FontSize 16
}
hide stereotype
top to bottom direction

label D6 [
----
**D6** Grading
and reports
----
]
label D5 [
----
**D5** Monitoring
evidence
----
]
label D8 [
----
**D8** Audit log
----
]
label D7 [
----
**D7** Notifications
----
]
usecase "**5.6**\nServe audit log,\nanalytics, results" as P56
rectangle "Admin /\nSuperAdmin" <<entity>> as ADM
rectangle "Student" <<entity>> as STU

D6 --> P56 : marks
D5 --> P56 : violations
D8 --> P56 : audit log
D7 --> P56 : notifications
P56 --> ADM : audit log,\nanalytics
P56 --> STU : results,\nnotifications
@enduml

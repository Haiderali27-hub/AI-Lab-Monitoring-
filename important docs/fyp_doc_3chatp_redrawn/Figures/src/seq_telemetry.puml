@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 220
hide footbox
hide unlinked
skinparam ParticipantPadding 4
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Student_Desktop_App/Views/ExamDashboard.xaml.cs, ViewModels/DashboardViewModel.cs, Services/LiveMonitoringService.cs;
' Backend_API/Controllers/ExamsController.cs (student/start), MonitoringController.cs (heartbeat, events/batch);
' Hubs/MonitoringHub.cs; Admin_Web_Panel/src/pages/teacher/LiveMonitorPage.tsx.
' Open arrowheads (->>) are one-way: Start() returns at once; pushes to the web page go to the exam's hub group, no reply.

participant "ExamDashboard\n(WPF client)" as VM
participant "LiveMonitoring\nService" as LM
participant "Exams\nController" as EC
participant "Monitoring\nController" as MC
participant "Heartbeat\nWatchdog" as WD
database "AppDbContext" as DB
participant "Live Monitor\npage (web)" as WEB
participant "Monitoring\nHub" as HUB

WEB -> HUB : join exam group
activate HUB
HUB --> WEB : joined
deactivate HUB
VM -> EC : start exam
activate EC
EC -> DB : check assignment, seat\nand readiness; create session
EC --> VM : 200 session
deactivate EC
VM ->> LM : start monitoring

par
  loop every 10 s
    LM -> MC : heartbeat
    activate MC
    MC -> DB : save heartbeat;\ncheck seat
    MC ->> WEB : StudentHeartbeat
    MC --> LM : ack (time left,\nstatus, warnings)
    deactivate MC
  end
else
  loop every 5 s (at once on a violation)
    LM -> MC : event batch
    activate MC
    MC -> DB : save new events;\naudit violations
    opt recent violation, session in progress
      MC ->> WEB : ViolationEvent
    end
    MC --> LM : accepted,\nduplicates
    deactivate MC
  end
end
@enduml

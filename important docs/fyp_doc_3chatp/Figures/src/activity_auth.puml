@startuml
!include style.iuml
' Student login with HWID v2 device binding
' (LoginViewModel, Core/DeviceFingerprint, AuthController.StudentLogin [EnableRateLimiting("login"):
' 10 requests/min per IP], HwidHelper.CanUpgradeToV2, Services/SessionStore, AuthController.Refresh)
' Print sizing (D6): large font at dpi 96, so PlantUML's fixed pixel gaps stay small next to the text;
' printed size = 22 * (printed width in pt) / (PNG width px), at least 7 pt at the width used in Chapter 5.
skinparam dpi 96
skinparam defaultFontSize 22
skinparam ArrowFontSize 22
skinparam ArrowThickness 1.5
skinparam padding 1
skinparam swimlane {
  TitleFontSize 23
}
!pragma useVerticalIf on

|Desktop App|
start
:Read v2 fingerprint (BIOS, disk,
baseboard serials via WMI) and
legacy v1; POST /api/auth/student-
login with email or roll number,
password and both fingerprints;
|Server|
if (More than 10 requests
this minute from this IP?) then ([yes])
  :429 Too Many
  Requests;
([no]) elseif (Credentials OK and
account active?) then ([no])
  :401 UNAUTHORIZED,
  audit LOGIN_FAILED;
([yes]) elseif (Role Student
and HWID sent?) then ([no])
  :401 FORBIDDEN or
  400 BAD_REQUEST;
else ([yes])
  if (DeviceBinding
  exists?) then ([no])
    :Save binding (SHA-256 of
    fingerprint), audit
    DEVICE_BOUND;
  else ([yes])
    if (Old v1 binding and
    v1 fingerprint matches?) then ([yes])
      :Re-bind to v2,
      audit DEVICE_REBOUND;
    else ([no])
    endif
  endif
  if (Hash matches
  binding?) then ([no])
    :401 DEVICE_MISMATCH,
    audit DEVICE_MISMATCH;
  else ([yes])
    :Update LastSeenAt, re-hash
    an old PBKDF2 password,
    issue JWT, UserSession and
    refresh token; audit
    LOGIN_SUCCESS;
  endif
endif
|Desktop App|
if (Login OK?) then ([yes])
  :Store tokens in
  SessionStore (renewed
  via /api/auth/refresh),
  open the dashboard;
else ([no])
  :Show the
  error message;
endif
stop
@enduml

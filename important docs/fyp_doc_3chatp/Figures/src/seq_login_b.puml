@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 220
hide footbox
hide unlinked
skinparam ParticipantPadding 4
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Student_Desktop_App/ViewModels/LoginViewModel.cs, Core/DeviceFingerprint.cs;
' Backend_API/Controllers/AuthController.cs (StudentLogin); Services/RefreshTokenService.cs.

actor Student
participant "LoginViewModel\n(WPF client)" as VM
participant "AuthController" as AC
participant "RefreshToken\nService" as RT
database "AppDbContext" as DB
activate VM
activate AC
alt first login (no binding)
  AC -> DB : bind device (SHA-256 of v2);\naudit DEVICE_BOUND
else old v1 binding matches
  AC -> DB : upgrade binding to v2;\naudit DEVICE_REBOUND
end
break fingerprint hash differs from binding
  AC -> DB : audit DEVICE_MISMATCH
  AC --> VM : 401 DEVICE_MISMATCH
end
AC -> AC : create JWT (with jti)
AC -> DB : audit LOGIN_SUCCESS;\nadd UserSession
AC -> RT : issue refresh token
activate RT
RT -> DB : store token hash\n(new family)
RT --> AC : refresh token
deactivate RT
AC -> DB : save changes
AC --> VM : 200 access token\n+ refresh token
deactivate AC
VM --> Student : open exam dashboard
deactivate VM
@enduml

@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 220
hide footbox
hide unlinked
skinparam ParticipantPadding 4
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Student_Desktop_App/ViewModels/LoginViewModel.cs, Core/DeviceFingerprint.cs;
' Backend_API/Controllers/AuthController.cs (StudentLogin); Services/RefreshTokenService.cs.
' Token refresh is drawn with logout in seq_logout.puml. Labels kept short; details are in the chapter text.

actor Student
participant "LoginViewModel\n(WPF client)" as VM
participant "AuthController" as AC
participant "RefreshToken\nService" as RT
database "AppDbContext" as DB

Student -> VM : email or roll no.\n+ password
activate VM
VM -> VM : read device\nfingerprint (v2 + v1)
VM -> AC : login request\n(credentials + fingerprints)
activate AC
AC -> DB : find active user\nand device binding
DB --> AC : user or none
break no user, or wrong password
  AC -> DB : audit LOGIN_FAILED
  AC --> VM : 401 UNAUTHORIZED
end
break role is not Student
  AC --> VM : 401 FORBIDDEN
end
AC -> AC : re-hash old hash if needed\n(PBKDF2, 600,000)
break no fingerprint sent
  AC --> VM : 400 HWID required
end
@enduml

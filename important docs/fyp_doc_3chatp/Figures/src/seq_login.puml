@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 2
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Student_Desktop_App/ViewModels/LoginViewModel.cs, Core/DeviceFingerprint.cs;
' Backend_API/Controllers/AuthController.cs (StudentLogin); Services/RefreshTokenService.cs.
' Token refresh is drawn with logout in seq_logout.puml.

actor Student
participant "LoginViewModel\n+ ApiClient (WPF)" as VM
participant "AuthController" as AC
participant "RefreshToken\nService" as RT
database "AppDbContext" as DB

Student -> VM : email or roll no.\n+ password
activate VM
VM -> VM : DeviceFingerprint:\nraw "v2|BIOS|DISK|BOARD"\n+ legacy v1
VM -> AC : POST /api/auth/student-login\n{usernameOrEmail, password,\nmachineName, hardwareFingerprint\n(v2), legacyHardwareFingerprint (v1)}
activate AC
AC -> DB : active User + DeviceBinding (by Email or RollNumber)
DB --> AC : user | null
break user null, or PasswordHelper.VerifyPassword = false
  AC -> DB : AuditLog LOGIN_FAILED
  AC --> VM : 401 UNAUTHORIZED
end
break Role != Student
  AC --> VM : 401 FORBIDDEN
end
AC -> AC : if NeedsRehash: re-hash, PBKDF2 600,000
break hardwareFingerprint empty
  AC --> VM : 400 BAD_REQUEST\n"HWID is required for student login."
end
@enduml

@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 2
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' User and role management (Module 7, UC-25 with UC-27's guard), part (c): device-binding reset.
' Code: Admin_Web_Panel/src/pages/admin/UsersPage.tsx (handleResetBinding; also DeviceBindingsPage.tsx),
' src/api/users.api.ts (usersApi.resetDeviceBinding);
' Backend_API/Controllers/UsersController.cs (ResetDeviceBinding, GuardExistingAsync);
' Services/RefreshTokenService.cs (RevokeOtherSessionsAsync); Services/AuditService.cs (Add, LogAsync).

actor "Admin /\nSuperAdmin" as A
participant "UsersPage\n(web)" as UI
participant "Users\nController" as UC
participant "RefreshToken\nService" as RT
participant "AuditService" as AS
database "AppDbContext" as DB

A -> UI : Reset device\nbinding (confirm)
activate UI
UI -> UC : DELETE /api/users/\n{id}/device-binding
activate UC
UC -> UC : GuardExistingAsync\n("reset-device-binding", id)
alt target is Admin or SuperAdmin\nand caller is not SuperAdmin
  UC -> AS : LogAsync(PRIVILEGED_\nACCOUNT_DENIED)
  activate AS
  AS -> DB : AuditLogs.Add;\nSaveChanges
  AS --> UC
  deactivate AS
  UC --> UI : 403 {code:\nSUPERADMIN_REQUIRED}
else no DeviceBinding row
  UC --> UI : 404 "No device\nbinding found."
else allowed
  UC -> RT : RevokeOtherSessionsAsync\n(id, null, DeviceReset)
  activate RT
  RT -> DB : refresh tokens and\nUserSessions revoked;\nSaveChanges
  RT --> UC : (revokedRefreshTokens,\nrevokedSessions)
  deactivate RT
  UC -> DB : DeviceBindings.Remove
  UC -> AS : Add(DEVICE_\nBINDING_RESET)
  activate AS
  AS -> DB : AuditLogs.Add\n(staged)
  deactivate AS
  UC -> DB : SaveChanges
  UC --> UI : 200 "Device binding\nreset. ..."
end
deactivate UC
UI --> A : result message
deactivate UI
note over UI, DB : The student is signed out everywhere; the next login\nbinds the new PC as a first binding (DEVICE_BOUND).
@enduml

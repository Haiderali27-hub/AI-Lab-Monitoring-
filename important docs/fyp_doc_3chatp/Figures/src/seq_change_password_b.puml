@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 2
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Admin_Web_Panel/src/components/layout/Navbar.tsx, src/api/auth.api.ts;
' Backend_API/Controllers/AuthController.cs (ChangePassword); Services/RefreshTokenService.cs; Helpers/PasswordHelper.cs.

actor "Staff user" as U
participant "Navbar\n(Web Panel)" as UI
participant "AuthController" as AC
participant "RefreshToken\nService" as RT
participant "PasswordHelper" as PH
database "AppDbContext" as DB
activate UI
activate AC
AC -> RT : RevokeOtherSessionsAsync\n(userId, jti, PasswordChanged)
activate RT
RT -> DB : other families' RefreshTokens revoked;\nother UserSessions IsRevoked = true;\nSaveChanges
RT --> AC : (revokedRefreshTokens,\nrevokedSessions)
deactivate RT
AC -> PH : GenerateSalt();\nHashPassword(new, salt)
activate PH
PH --> AC : salt, PBKDF2 hash\n(600,000 iterations)
deactivate PH
AC -> DB : update User.Salt + PasswordHash;\nAuditLog PASSWORD_CHANGED; SaveChanges
AC --> UI : 200 "Password updated successfully."
deactivate AC
UI --> U : success message
deactivate UI
note over UI, DB : The caller's own session and refresh-token family stay valid.
@enduml

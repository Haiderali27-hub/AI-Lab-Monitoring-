@startuml
!include style.iuml
' Part (b): reports and read-only services, processes 5.5 and 5.6; 5.1-5.4 are in dfd_level_2b.puml (part a).
' DFD level 2 of process 5.0 (Evaluation and reporting). Process 3.0 is in
' dfd_level_2.puml. Same entities, numbers and stores (D1..D8) as level 1.
' Yourdon/DeMarco notation: circle = process, rectangle = external entity,
' two lines = data store, dashed circle = level-1 process outside 5.0,
' dashed rectangle = optional entity, * = store or entity drawn twice.
skinparam defaultFontSize 16
skinparam ArrowFontSize 16
skinparam nodesep 14
skinparam ranksep 34
skinparam defaultTextAlignment center
skinparam rectangle<<entity>> {
  BorderThickness 2
  RoundCorner 0
  BackgroundColor #FFFFFF
}
skinparam rectangle<<optional>> {
  RoundCorner 0
  BorderStyle dashed
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BorderColor #333333
  BorderThickness 2
  BackgroundColor #F2F2F2
}
skinparam usecase<<ref>> {
  BorderStyle dashed
  BorderThickness 1
  BackgroundColor #FFFFFF
}
skinparam label {
  FontSize 16
}
hide stereotype

rectangle "Admin /\nSuperAdmin" <<entity>> as ADM
rectangle "Student" <<entity>> as STU
usecase "**5.5**\nBuild reports\nand exports" as P55
usecase "**5.6**\nServe audit log,\nanalytics, results" as P56
label D3 [
----
**D3**
Departments,
Courses, Sections,
SectionEnrollments,
Labs,
Workstations,
AttendanceRecords,
ExamAssignments,
ExamProctors
----
]
label D5 [
----
**D5**
MonitoringEvents,
Screenshots,
Incidents
----
]
label D6 [
----
**D6**
AiGradingResults,
TestCaseResults,
PlagiarismResults,
TeacherGradeOverrides,
ExamReports
----
]
label D7 [
----
**D7**
Notifications
----
]
label D8 [
----
**D8** AuditLogs
----
]
rectangle "Teacher" <<entity>> as TEA2
label D4b [
----
**D4**
ExamSessions,
Answers,
ReadinessChecks
----
]

' ---- reports and read-only services (5.5, 5.6)
D6 --> P55 : marks, report\nlist
D3 --> P55 : attendance,\neligibility
D4b --> P55 : sessions
D5 --> P55 : events,\nscreenshots,\nincidents
D8 --> P55 : exam's audit\nextract
D6 <-- P55 : ExamReports
D8 <-- P55 : REPORT_GENERATED\n(file SHA-256)
P55 <-- TEA2 : report request\n(type)
P55 --> TEA2 : exam summary\nPDF; attendance,\nviolations,\nscores PDFs;\nExcel; evidence\nZIP
D8 --> P56 : audit entries,\nhash chain
D6 --> P56 : marks
D5 --> P56 : violation counts
D7 --> P56 : notifications
P56 --> ADM : audit log, chain\nstatus (valid /\nbrokenAt),\nanalytics
P56 --> STU : results,\nviolation\nhistory,\nperformance,\nnotifications
@enduml

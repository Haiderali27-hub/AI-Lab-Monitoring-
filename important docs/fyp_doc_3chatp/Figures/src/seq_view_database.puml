@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 2
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Admin_Web_Panel/src/pages/teacher/live/StudentDrawer.tsx, ScreenshotCarousel.tsx;
' Backend_API/Controllers/MonitoringEvidenceController.cs; Services/ExamAccessService.cs; EvidenceStorage.

actor "Teacher /\nInvigilator /\nAdmin" as U
participant "StudentDrawer +\nScreenshotCarousel\n(Live Monitor)" as UI
participant "MonitoringEvidence\nController" as MC
participant "ExamAccess\nService" as EA
participant "Evidence\nStorage" as ES
database "AppDbContext" as DB

U -> UI : open a student's tile
activate UI
UI -> MC : GET /api/exams/{examId}/\nsessions/{sessionId}/timeline\n(roles Teacher, Admin,\nSuperAdmin, Invigilator)
activate MC
MC -> EA : DenyUnlessAsync\n(user, examId, Proctor)
activate EA
EA -> DB : Exam -> Section.TeacherId; ExamProctors
DB --> EA : rows
EA --> MC : null | 404 | 403
deactivate EA
break unknown exam, or caller not owner teacher,\nassigned invigilator or admin
  MC --> UI : 404 "Exam not found." | 403 "You are\nnot assigned to supervise this exam."
end
MC -> DB : ExamSession(sessionId, examId) (none: 404)
DB --> MC : session
MC -> DB : MonitoringEvents (no Heartbeat), Screenshots,\nNotifications (warnings), Incidents, AuditLogs
DB --> MC : rows
MC -> MC : merge, newest first, limit 200 (max 500)
MC --> UI : 200 [TimelineItem]
deactivate MC
@enduml

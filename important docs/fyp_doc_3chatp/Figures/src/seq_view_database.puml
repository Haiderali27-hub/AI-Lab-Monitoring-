@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 220
hide footbox
hide unlinked
skinparam ParticipantPadding 4
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Admin_Web_Panel/src/pages/teacher/live/StudentDrawer.tsx;
' Backend_API/Controllers/MonitoringEvidenceController.cs (timeline); Services/ExamAccessService.cs.

actor "Teacher /\nInvigilator /\nAdmin" as U
participant "Live Monitor\nstudent drawer\n(web panel)" as UI
participant "MonitoringEvidence\nController" as MC
participant "ExamAccess\nService" as EA
participant "Evidence\nStorage" as ES
database "AppDbContext" as DB

U -> UI : open a student's tile
activate UI
UI -> MC : get session timeline
activate MC
MC -> EA : check exam access
activate EA
EA -> DB : exam owner and\nassigned invigilators
DB --> EA : rows
EA --> MC : allowed, 404 or 403
deactivate EA
break unknown exam (404), or not owner,\nassigned invigilator or admin (403)
  MC --> UI : 404 or 403
end
MC -> DB : load session (none: 404)
DB --> MC : session
MC -> DB : events (no heartbeats),\nscreenshots, warnings,\nincidents, audit logs
DB --> MC : rows
MC -> MC : merge, newest\nfirst (limit 200)
MC --> UI : 200 timeline
deactivate MC
@enduml

@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 6
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Exam configuration (Module 8): Admin_Web_Panel/src/pages/teacher/CreateExamPage.tsx (examsApi.getSections, then getById in
' edit mode, then getSectionStudents(selectedSectionId), create / update, then navigate('/teacher/dashboard')).
' ExamsController [Authorize(Roles = "Teacher,Admin,SuperAdmin")]: GET sections, GET {id}, GET sections/{sectionId}/students;
' CreateExam (POST /api/exams) / UpdateExam (PUT /api/exams/{id}: 404 not found, 403 not own section, 409 not Scheduled, then
' validation); ValidateExamPayloadAsync (400 messages, 404 section, 403 not own section); RefuseOtherTeachersStudentsAsync
' (403 for a Teacher assigning another teacher's students); MapQuestions; AuditService.Add EXAM_CREATED / EXAM_UPDATED;
' one SaveChangesAsync, in which AuditChain seals the audit row.

actor Teacher
participant "Create Exam\npage (web)" as P
participant "Exams\nController" as EC
database "AppDbContext" as DB

Teacher -> P : New exam / Edit
activate P
P -> EC : get sections
activate EC
EC --> P : own sections\n(all for an admin)
deactivate EC
opt edit
  P -> EC : get exam
  activate EC
  EC --> P : exam, questions,\ntest cases
  deactivate EC
end
P -> EC : get section students
activate EC
EC --> P : students
deactivate EC
P --> Teacher : form
deactivate P

Teacher -> P : fill in and save
activate P
P -> EC : create or update exam
activate EC
opt update
  EC -> EC : exists? own section?\nstill Scheduled?
end
EC -> EC : validate exam;\nown students only\n(teacher)
alt invalid or not allowed
  EC --> P : error message
else valid
  EC -> DB : save exam, questions,\ntest cases, students\n+ audit entry
  activate DB
  DB --> EC : saved; audit entry sealed
  deactivate DB
  EC --> P : created / updated
end
deactivate EC
P --> Teacher : error, or back\nto the dashboard
deactivate P
@enduml

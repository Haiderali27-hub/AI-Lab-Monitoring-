@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 2
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Student_Desktop_App/Views/ExamDashboard.xaml.cs, ViewModels/DashboardViewModel.cs, Services/LiveMonitoringService.cs;
' Backend_API/Controllers/ExamsController.cs (student/start), MonitoringController.cs (heartbeat, events/batch, screenshot);
' Services/Monitoring/HeartbeatWatchdogService.cs; Hubs/MonitoringHub.cs; Admin_Web_Panel/src/pages/teacher/LiveMonitorPage.tsx.
' Open arrowheads (->>) are one-way messages: Start() returns at once, and every push to the web page is
' IHubContext<MonitoringHub>.Clients.Group("exam:{id}").SendAsync(...), with no reply.

participant "ExamDashboard\n+ Dashboard\nViewModel" as VM
participant "LiveMonitoring\nService" as LM
participant "Exams\nController" as EC
participant "Monitoring\nController" as MC
participant "Heartbeat\nWatchdog\nService" as WD
database "AppDbContext" as DB
participant "LiveMonitorPage\n(web), in group\nexam:{id}" as WEB
participant "Monitoring\nHub" as HUB

WEB -> HUB : JoinExamGroup\n(examId)
activate HUB
HUB --> WEB : joined
deactivate HUB
VM -> EC : POST /api/exams/student/start
activate EC
EC -> DB : assignment, seat and readiness\ngates; insert ExamSession (InProgress)
EC --> VM : 200 {id, status, startedAtUtc}
deactivate EC
VM ->> LM : Start(token,\nsessionId, ...)

par
  loop every 10 s
    LM -> MC : POST /api/monitoring/heartbeat\n{examSessionId, cameraStatus,\nisForegroundExamApp, ...}
    activate MC
    MC -> DB : LastHeartbeatAt; Heartbeat event\n(on change or every 60 s); seat check
    MC ->> WEB : StudentHeartbeat
    MC --> LM : HeartbeatAck {remaining\nSeconds, sessionStatus,\nwarnings, ...}
    deactivate MC
  end
else
  loop outbox every 5 s (at once on a violation)
    LM -> MC : POST /api/monitoring/events/batch\n{examSessionId, events[...]}
    activate MC
    MC -> DB : insert MonitoringEvents (dedup); AuditLog\nMONITORING_VIOLATION if any violation
    opt session InProgress, violation recorded <= 60 s ago
      MC ->> WEB : ViolationEvent
    end
    MC --> LM : {accepted, duplicates}
    deactivate MC
  end
end
@enduml

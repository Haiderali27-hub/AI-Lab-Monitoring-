@startuml
!include style.iuml
' Class diagram, part 1 of 3 (core entities) from Backend_API/Models (EF Core). Entity ids are Guid.
' Part 2 (desktop client) is class_diagram_client.puml, part 3 (server services) is class_diagram_server.puml.
' Only key members are shown.
hide empty members
hide circle
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 55
skinparam class {
  FontSize 13
  AttributeFontSize 12
}
skinparam ArrowFontSize 12
skinparam stereotypeFontSize 10

class User #EAF6EA {
  +UserId : Guid
  +Email : string
  +Role : UserRole
}
enum UserRole <<enumeration>> #EAF6EA {
  SuperAdmin
  Admin
  Teacher
  Invigilator
  Student
}
class DeviceBinding #EAF6EA {
  +UserId : Guid
  +HwidHash : string
}
class Section #EAF6EA {
  +SectionId : Guid
  +TeacherId : Guid
}
class ExamProctor #EAF6EA {
  +ExamId : Guid
  +UserId : Guid
}
class Workstation #EAF6EA {
  +WorkstationId : Guid
  +MachineNumber : string
  +HostName : string?
}
class Exam #EAF6EA {
  +ExamId : Guid
  +StartTime : DateTime
  +AllowedApps : string [JSON]
  +LockdownMode : LockdownMode
}
class Question #EAF6EA {
  +Type : QuestionType
  +Marks : int
}
class ExamAssignment #EAF6EA {
  +WorkstationId : Guid?
  +IsEligible : bool
}
class ExamSession #EAF6EA {
  +SessionId : Guid
  +Status : SessionStatus
  +ExtraMinutes : int
  +ReceiptSha256 : string?
}
class Answer #EAF6EA {
  +AnswerText : string
  +Revision : int
}
class MonitoringEvent #EAF6EA {
  +EventType : MonitoringEventType
  +Payload : string [JSON]
}
class AiGradingResult #EAF6EA {
  +SuggestedMarks : double
  +Confidence : string
  +Status : string
}

User -left-> UserRole
User "1" -right- "0..1" DeviceBinding
User "1" -- "*" Section : teaches
User "1" -- "*" ExamProctor
User "1" -- "*" ExamAssignment
User "1" -- "*" ExamSession
Section "1" -- "*" Exam
Exam "1" -- "*" ExamProctor
Exam "1" *-- "*" Question
Exam "1" -- "*" ExamAssignment
Workstation "0..1" -- "*" ExamAssignment
Exam "1" -- "*" ExamSession
ExamSession "1" *-- "*" Answer
Question "1" -- "*" Answer
ExamSession "1" *-- "*" MonitoringEvent
Answer "1" -- "0..1" AiGradingResult
@enduml

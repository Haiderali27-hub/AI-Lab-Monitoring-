@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 2
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Backend_API/Controllers/ExamsController.cs (Submit); Services/SubmissionService.cs (FinalizeAsync);
' Services/Grading/GradingService.cs (StageAsync), TheoryGrader.cs, PlagiarismService.cs (DetectAsync),
' PlagiarismEngine.cs, PlagiarismFingerprintCache.
' Background code grading of the queued answers: seq_compilation.puml. Teacher heat map: seq_plagiarism_matrix.puml.
' Open arrowheads (->>) are one-way: Enqueue writes to an unbounded channel; SessionFinalized is a SignalR group push.

participant "Submission\nService" as SS
participant "Grading\nService" as GS
participant "Plagiarism\nService" as PS
participant "Plagiarism\nEngine" as PE
database "AppDbContext" as DB

[-> SS : ExamsController.Submit\n-> FinalizeAsync\n(session, Submitted)
activate SS
SS -> DB : session's Answers (+ Question)
DB --> SS : answers
opt Exam.AiEvaluationEnabled
  SS -> GS : StageAsync(answers)
  activate GS
  loop each answer not graded yet
    alt Theory, LLM grader off (default) or blank
      GS -> GS : TheoryGrader.Grade:\n0.7 x TF-IDF cosine vs\nReferenceAnswer + 0.3 x\nkey-term coverage
    else Non-blank: Coding with a runner, or Theory with LLM on
      GS -> GS : Pending (queued)
    else Coding blank, or Grading:Runner = None
      GS -> GS : graded at once\n(0 marks / not run)
    else MCQ
      GS -> GS : marked by option index
    end
    GS -> DB : add AiGradingResult
  end
  GS --> SS : toGrade (answerIds)
  deactivate GS
end
@enduml

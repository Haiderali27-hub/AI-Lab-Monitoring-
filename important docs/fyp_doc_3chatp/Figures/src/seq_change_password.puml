@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 2
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Admin_Web_Panel/src/components/layout/Navbar.tsx, src/api/auth.api.ts;
' Backend_API/Controllers/AuthController.cs (ChangePassword); Services/RefreshTokenService.cs; Helpers/PasswordHelper.cs.

actor "Staff user" as U
participant "Navbar\n(Web Panel)" as UI
participant "AuthController" as AC
participant "RefreshToken\nService" as RT
participant "PasswordHelper" as PH
database "AppDbContext" as DB

U -> UI : current + new +\nconfirm password
activate UI
break next.length < 8 or next != confirm
  UI --> U : inline error (no request)
end
UI -> AC : POST /api/auth/change-password\n{currentPassword, newPassword}
activate AC
AC -> DB : Users.Find(userId from JWT)
DB --> AC : user
AC -> PH : VerifyPassword(current,\nSalt, PasswordHash)
activate PH
PH --> AC : bool
deactivate PH
break current password wrong
  AC -> DB : AuditLog PASSWORD_CHANGE_FAILED
  AC --> UI : 400 "Current password is incorrect."
end
break new password shorter than 8
  AC --> UI : 400 "New password must be\nat least 8 characters."
end
@enduml

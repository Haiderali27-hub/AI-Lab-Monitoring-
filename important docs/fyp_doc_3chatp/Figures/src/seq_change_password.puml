@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 220
hide footbox
hide unlinked
skinparam ParticipantPadding 4
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Admin_Web_Panel/src/components/layout/Navbar.tsx, src/api/auth.api.ts;
' Backend_API/Controllers/AuthController.cs (ChangePassword); Helpers/PasswordHelper.cs.

actor "Staff user" as U
participant "Navbar\n(web panel)" as UI
participant "AuthController" as AC
participant "RefreshToken\nService" as RT
participant "PasswordHelper" as PH
database "AppDbContext" as DB

U -> UI : current, new and\nconfirm password
activate UI
break new < 8 characters,\nor confirm does not match
  UI --> U : inline error\n(no request sent)
end
UI -> AC : change-password request
activate AC
AC -> DB : load user (from JWT)
DB --> AC : user
AC -> PH : verify current password
activate PH
PH --> AC : true or false
deactivate PH
break current password wrong
  AC -> DB : audit\nPASSWORD_CHANGE_FAILED
  AC --> UI : 400 wrong password
end
break new password < 8 characters
  AC --> UI : 400 too short
end
@enduml

@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 2
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Student_Desktop_App/Services/ApiClient.cs (TokenRefreshGate), Views/ExamDashboard.xaml.cs (LogoutButton_OnClick);
' Backend_API/Controllers/AuthController.cs (Refresh, Logout); Services/RefreshTokenService.cs.

actor Student
participant "ExamDashboard\n+ ApiClient (WPF)" as UI
participant "AuthController" as AC
participant "RefreshToken\nService" as RT
database "AppDbContext" as DB
== logout ==
Student -> UI : Logout
activate UI
UI -> UI : LiveMonitoringService.Stop()
UI -> AC : POST /api/auth/logout\n(Bearer JWT)
activate AC
note over AC, DB : JWT middleware rejects a revoked UserSession (401)
AC -> RT : RevokeFamilyByJtiAsync\n(jti, Logout)
activate RT
RT -> DB : jti's family: RefreshTokens RevokedAt = now,\nUserSessions IsRevoked = true; SaveChanges
RT --> AC : revoked count
deactivate RT
AC -> DB : UserSession(jti) IsRevoked = true;\nAuditLog LOGOUT; SaveChanges
AC --> UI : 200 "Logged out successfully."
deactivate AC
UI -> UI : SessionStore.Clear()
UI --> Student : show LoginWindow
deactivate UI
@enduml

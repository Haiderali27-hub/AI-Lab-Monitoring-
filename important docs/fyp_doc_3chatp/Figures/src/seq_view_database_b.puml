@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 220
hide footbox
hide unlinked
skinparam ParticipantPadding 4
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Admin_Web_Panel/src/pages/teacher/live/ScreenshotCarousel.tsx;
' Backend_API/Controllers/MonitoringEvidenceController.cs (screenshots, content); Services/ExamAccessService.cs; EvidenceStorage.

actor "Teacher /\nInvigilator /\nAdmin" as U
participant "Live Monitor\nstudent drawer\n(web panel)" as UI
participant "MonitoringEvidence\nController" as MC
participant "ExamAccess\nService" as EA
participant "Evidence\nStorage" as ES
database "AppDbContext" as DB
activate UI
UI -> MC : get capture list
activate MC
MC -> EA : check access (same rule)
activate EA
EA --> MC : allowed, 404 or 403
deactivate EA
MC -> DB : session (none: 404) and its\nscreenshots, newest first
DB --> MC : rows
MC --> UI : 200 capture list
deactivate MC
loop each capture shown
  UI -> MC : get image
  activate MC
  MC -> DB : find screenshot (none: 404)
  DB --> MC : screenshot
  MC -> EA : check access (none: 403)
  activate EA
  EA --> MC : access level
  deactivate EA
  MC -> ES : open image file
  activate ES
  ES --> MC : file (missing: 404)
  deactivate ES
  MC --> UI : image
  deactivate MC
end
UI --> U : timeline + captures
deactivate UI
@enduml

@startuml
!include style.iuml
' DFD level 1, part (a): processes 1.0-3.0 (sign-in, exam set-up, the exam
' session on the lab PC). Part (b) is dfd_level_1b.puml (4.0, 5.0).
' Yourdon/DeMarco notation: circle = process, rectangle = external entity,
' two horizontal lines = data store "Dn" (named after its tables),
' labelled arrow = data flow, two-headed arrow = read and update;
' dashed circle = a process drawn in the other part; * = entity drawn twice.
skinparam defaultFontSize 16
skinparam ArrowFontSize 16
skinparam nodesep 14
skinparam ranksep 34
skinparam defaultTextAlignment center
skinparam rectangle<<entity>> {
  BorderThickness 2
  RoundCorner 0
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BorderColor #333333
  BorderThickness 2
  BackgroundColor #F2F2F2
}
skinparam usecase<<ref>> {
  BorderStyle dashed
  BorderThickness 1
  BackgroundColor #FFFFFF
}
skinparam label {
  FontSize 16
}
hide stereotype

rectangle "Student" <<entity>> as STU
rectangle "Admin /\nSuperAdmin" <<entity>> as ADM
rectangle "Teacher" <<entity>> as TEA
rectangle "Email server\n(SMTP)" <<entity>> as SMTP
rectangle "Student *" <<entity>> as STU2

usecase "**1.0**\nAuthenticate\nand bind device" as P1
usecase "**2.0**\nConfigure exams\nand run sessions" as P2
usecase "**3.0**\nLockdown and\ntelemetry" as P3
usecase "**4.0**\nLive proctoring\n(part b)" <<ref>> as P4
usecase "**5.0**\nEvaluation and\nreporting (part b)" <<ref>> as P5

label D1 [
----
**D1** Users,
DeviceBindings,
UserSessions,
RefreshTokens
----
]
label D2 [
----
**D2** Exams, Questions,
TestCases
----
]
label D3 [
----
**D3** Departments,
Courses, Sections,
SectionEnrollments,
Labs, Workstations,
AttendanceRecords,
ExamAssignments,
ExamProctors
----
]
label D4 [
----
**D4** ExamSessions,
Answers, ReadinessChecks
----
]
label D5 [
----
**D5** MonitoringEvents,
Screenshots, Incidents
----
]
label D7 [
----
**D7** Notifications
----
]
label D8 [
----
**D8** AuditLogs
----
]

' ---- row 0: entities; row 1: 1.0, 2.0; row 2: stores; row 3: 3.0; row 4: D5, 4.0
ADM --> P1 : users, roles,\nbinding reset
STU --> P1 : credentials, PC\nhardware IDs
STU <-- P1 : sign-in result
ADM --> P2 : departments,\ncourses, labs,\nworkstations
STU --> P2 : start, answers,\nsubmit
STU <-- P2 : exam list,\nquestions, receipt\nhash
TEA --> P2 : exam settings,\nattendance CSV,\nseats, invigilators,\nannouncements

' ---- 1.0
P1 --> D1 : binding, sessions,\nrefresh tokens
P1 <-- D1 : password hash,\nbinding
P1 --> D8 : login, device and\nuser events

' ---- 2.0
P2 <--> D2 : exams, questions,\ntest cases
P2 <--> D3 : academic structure,\nlabs, attendance,\neligibility, seats,\ninvigilators
P2 <--> D4 : sessions, answers,\nreadiness
P2 --> D7 : announcements,\nnotices
P2 --> D8 : exam, eligibility,\nassignment, academic\nand lab changes
P2 --> SMTP : emails
P2 --> P5 : submitted session

' ---- 3.0
D2 --> P3 : lockdown mode,\nAllowedApps,\nintervals
D3 --> P3 : assigned seat
D4 --> P3 : session, extra time,\nunlock
D4 <-- P3 : LastHeartbeatAt,\nIsDisconnected
D7 --> P3 : unread warnings
D1 <-- P3 : LastSeenAt
D8 <-- P3 : seat, violation and\nconnection events
P3 <-- STU2 : activity on the PC\n(apps, keys, USB,\nmonitors); screen,\nwebcam image
P3 --> STU2 : lockdown, warnings,\nextra time, unlock
P3 --> D5 : events, screenshots,\nwebcam snapshots
P3 <-- D5 : session's violations
P3 --> P4 : heartbeats, classed\nevents, alerts
@enduml

@startuml
!include style.iuml
' Auto-save and crash recovery (ViewModels/ExamSessionViewModel, Core/Submission/AutosaveScheduler,
' OfflineSaveQueue, AnswerMerge, Core/Backup/AnswerBackupStore + AnswerBackupCodec,
' ExamsController.SaveAnswer / StudentStart / GetSessionAnswers, Core/Dashboard/StartGate.CanResume)
' Simplified labels: AES-256-GCM, DPAPI, status codes and endpoints are in the chapter text.
' Large font at dpi 96. Printed pt = fontSize * printed_width_pt / png_width_px.
skinparam dpi 96
skinparam defaultFontSize 22
skinparam ArrowFontSize 22
skinparam ArrowThickness 1.5
skinparam padding 1
skinparam swimlane {
  TitleFontSize 23
}

|Desktop App|
start
repeat
  :Edit answer, update
  encrypted local
  backup within 1 s;
  :Save after 10 s, on
  question change or
  focus loss;
  if (Server
  reachable?) then ([no])
    :Queue offline,
    replay later;
  else ([yes])
    |Server|
    :Keep the newer
    revision;
    |Desktop App|
  endif
repeat while (Exam still\nrunning?) is ([yes]) not ([no])
if (Crash or
power cut?) then ([no])
  :Normal close;
  stop
else ([yes])
endif
:Relaunch, log in,
Resume Exam;
|Server|
:Return the same
session and its
answers;
|Desktop App|
if (Backup
intact?) then ([yes])
  :Merge: higher
  revision wins;
else ([no])
  :Use server copy,
  report tampering;
endif
:Continue
the exam;
stop
@enduml

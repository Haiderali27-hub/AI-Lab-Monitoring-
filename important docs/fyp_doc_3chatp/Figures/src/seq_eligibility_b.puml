@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 6
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Attendance import and eligibility (Module 9, UC-20), part (b): recalculation from attendance.
' Code: Admin_Web_Panel/src/pages/teacher/EligibilityPage.tsx (handleRecalculate),
' src/api/exams.api.ts (examsApi.recalculateEligibility);
' Backend_API/Controllers/ExamsController.cs (RecalculateEligibility, CanManage);
' Services/EligibilityCalculator.cs (Decide); Models/Exam.cs (MinAttendancePercent = 75); Services/AuditService.cs (Add).

actor Teacher as T
participant "Eligibility\npage (web)" as UI
participant "Exams\nController" as EC
participant "Eligibility\nCalculator" as EL
participant "Audit\nService" as AS
database "AppDbContext" as DB

T -> UI : Recalculate
activate UI
UI -> EC : recalculate\neligibility
activate EC
EC -> DB : exam, section,\nassignments
break exam missing or\nnot own section
  EC --> UI : refused
end
break exam ended
  EC --> UI : conflict
end
EC -> DB : attendance\nrecords
loop each assignment
  alt overridden
    EC -> EC : skip
  else attendance-driven
    EC -> EL : decide (attended,\ntotal, minimum)
    activate EL
    EL --> EC : decision
    deactivate EL
    alt no record or\nno classes
      EC -> EC : note only;\nkeep decision
    else eligible if percent\n>= minimum\n(default 75 %)
      EC -> EC : set eligibility
      EC -> AS : ELIGIBILITY_\nCOMPUTED
    end
  end
end
EC -> AS : ELIGIBILITY_\nRECALCULATED
activate AS
AS -> DB : add audit row
deactivate AS
EC -> DB : save
EC --> UI : summary counts
deactivate EC
UI --> T : summary
deactivate UI
@enduml

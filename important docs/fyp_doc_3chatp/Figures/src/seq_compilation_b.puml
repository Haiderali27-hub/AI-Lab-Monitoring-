@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 2
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' Code: Services/Grading/GradingQueue.cs (GradingQueue, GradingWorker), GradingService.cs (ProcessAsync, GradeCodeAsync),
' CodeRunnerResolver.cs, DockerCodeRunner.cs, LocalMingwCodeRunner.cs, TestCaseScorer.cs, CodeAnalyzer.cs.
' The submit side (StageAsync, Enqueue, receipt) is drawn in seq_ai_plagiarism.puml.
' Open arrowheads (->>) are one-way: Enqueue writes the id to an unbounded channel, and GradingCompleted is
' IHubContext<MonitoringHub>.Clients.Group("exam:{id}").SendAsync(...).

participant "GradingQueue\n(filled by\nFinalizeAsync)" as GQ
participant "GradingWorker\n(MaxParallel: 2\nconsumers)" as GW
participant "GradingService" as GS
database "AppDbContext" as DB
participant "DockerCodeRunner\n(or LocalMingw\nCodeRunner)" as DR
participant "LiveMonitor\nPage (web)" as WEB
loop each answerId (continued)
activate GW
activate GS
  alt no runner, or language not C/C++
    GS -> GS : 0 marks, Low,\n"Not compiled - teacher review"
  else runner available (Docker shown)
    loop attempt 1..MaxAttempts (3) until a RunReport;\nback-off 2 s x attempt after an exception
      GS -> DR : RunAsync(CodeJob: source,\ncases, limits)
      activate DR
      DR -> DR : docker run:\ncompile once,\nrun each case\n(own time limit)
      DR --> GS : RunReport (compile output,\nexit code, time, output per case)\n| exception
      deactivate DR
    end
    note over GS, DR
      Docker run options: network none, read-only,
      cap-drop ALL, memory 256m, cpus 0.5, pids-limit 64,
      user 65534; gcc -std=c11 / g++ -std=c++17 -O0.
      LocalMingwCodeRunner: same flags, static build,
      each case in a Windows Job Object (not isolated).
    end note
    alt RunReport returned
      GS -> GS : TestCaseScorer.Score\n(OutputComparer) +\nCodeAnalyzer.Analyze
    else every attempt failed
      GS -> GS : 0 marks, Low,\nStatus = Failed;\ncases NotRun
    end
  end
  GS -> DB : AiGradingResult (marks, confidence,\njustification) + TestCaseResults;\nAuditLog AI_GRADING_COMPLETED\n(or _FAILED); SaveChanges
  GS ->> WEB : GradingCompleted {examId,\nsessionId, answerId, status}
  GS --> GW : done
  deactivate GS
  deactivate GW
end
@enduml

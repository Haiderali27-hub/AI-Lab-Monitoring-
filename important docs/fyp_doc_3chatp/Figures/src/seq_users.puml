@startuml
!include style.iuml
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam maxMessageSize 200
hide footbox
hide unlinked
skinparam ParticipantPadding 6
skinparam BoxPadding 0
skinparam sequence {
  MessageAlign left
  LifeLineBackgroundColor #E6E6E6
}
' User and role management (Module 7, UC-23, UC-27), part (a): create one account.
' Code: Admin_Web_Panel/src/pages/admin/UsersPage.tsx (handleSubmitUser), src/api/users.api.ts (usersApi.create),
' src/utils/roles.ts (assignableRoles: Admin/SuperAdmin offered only to a SuperAdmin);
' Backend_API/Controllers/UsersController.cs (Create, GuardPrivilegedAsync); Services/AuditService.cs (Add, LogAsync);
' Helpers/PasswordHelper.cs.

actor "Admin /\nSuperAdmin" as A
participant "Users\npage (web)" as UI
participant "Users\nController" as UC
participant "Audit\nService" as AS
database "AppDbContext" as DB

A -> UI : Add User: name, email,\npassword, role
activate UI
UI -> UC : create user
activate UC
UC -> UC : role valid?\nrole allowed?
alt unknown role
  UC --> UI : error
else Admin / SuperAdmin role,\ncaller not SuperAdmin
  UC -> AS : log denial
  activate AS
  AS -> DB : save PRIVILEGED_\nACCOUNT_DENIED
  AS --> UC
  deactivate AS
  UC --> UI : refused
else email or roll no. in use
  UC --> UI : conflict
else allowed
  UC -> UC : hash password\n(PBKDF2)
  UC -> DB : add user
  UC -> AS : USER_CREATED
  activate AS
  AS -> DB : add audit row
  deactivate AS
  UC -> DB : save
  UC --> UI : created
end
deactivate UC
UI --> A : updated list,\nor the error
deactivate UI
@enduml

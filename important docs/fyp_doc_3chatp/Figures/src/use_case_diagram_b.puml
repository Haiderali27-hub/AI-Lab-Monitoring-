@startuml
' UML 2.5 use case diagram, figure (b): the staff use cases of the web panel. Figure (a), the student's
' use cases and live supervision (UC-01 to UC-14), is use_case_diagram.puml.
' Every use case carries its ID (UC-nn, as in the Chapter 4 description tables) and its FR.
!include style.iuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 8
skinparam ranksep 34
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam usecase {
  FontSize 14
}
skinparam actor {
  FontSize 14
}
skinparam rectangle {
  FontSize 14
}

actor "Email server\n(SMTP)" as SMTP <<system>>
actor "Invigilator" as INV
actor "Teacher" as TEA
actor "Admin" as ADM
actor "SuperAdmin" as SUP

rectangle "SmartExam" {
  rectangle "Web panel (React)" as WEB {
    usecase "UC-12 Sign in, change\npassword, sign out (FR1)" as U12
    usecase "UC-13 Create and\nconfigure exam (FR8)" as U14
    usecase "UC-19 Announce exam, notify\nschedule and grades (FR8)" as U15
    usecase "UC-20 Import attendance,\nset eligibility (FR9)" as U16
    usecase "UC-15 Assign workstations\nand invigilators (FR9)" as U17
    usecase "UC-16 Review suggested marks\n(FR11.1, FR11.2)" as U18
    usecase "UC-17 Review similarity\nmatrix (FR11.3)" as U19
    usecase "UC-18 Export reports\nand evidence (FR12)" as U20
    usecase "UC-23 Manage users\nand roles (FR7)" as U21
    usecase "UC-24 Manage departments\nand courses (FR7)" as U22
    usecase "UC-25 Reset device\nbinding (FR1, FR7)" as U23
    usecase "UC-26 Register labs and\nworkstations (FR9)" as U24
    usecase "UC-21 Read audit log,\nverify hash chain (FR12)" as U25
    usecase "UC-22 View system\nanalytics (FR12)" as U26
    usecase "UC-27 Manage Admin and\nSuperAdmin accounts (FR7)" as U27
  }
}

U12 -- INV

U14 -- TEA
U15 -- TEA
U16 -- TEA
U17 -- TEA
U18 -- TEA
U19 -- TEA
U20 -- TEA
SMTP --- U15

U21 -- ADM
U22 -- ADM
U23 -- ADM
U24 -- ADM
U25 -- ADM
U26 -- ADM

U27 -- SUP

INV <|-right- TEA
TEA <|-right- ADM
ADM <|-right- SUP
@enduml

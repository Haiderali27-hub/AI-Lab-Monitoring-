@startuml
' UML 2.5 use case diagram. Subject = SmartExam (two subsystems); actors outside.
' Every use case carries its ID (UC-nn, as in Chapter 4); the UC-to-FR mapping is given in the text.
' Drawn as two figures: (a) this file: the student's use cases and live supervision;
' (b) use_case_diagram_b.puml: the staff use cases of the web panel (Teacher, Admin, SuperAdmin).
!include style.iuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 8
skinparam ranksep 34
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam usecase {
  FontSize 14
}
skinparam actor {
  FontSize 14
}
skinparam rectangle {
  FontSize 14
}

actor "Student" as STU
actor "Invigilator" as INV

rectangle "SmartExam" {
  rectangle "Desktop client" as DESK {
    usecase "UC-01 Log in and\nbind device" as U01
    usecase "UC-02 Run\nreadiness check" as U02
    usecase "UC-03 Take\npractice exam" as U03
    usecase "UC-04 Check in\nand start exam" as U04
    usecase "UC-05 Receive\ninvigilator action" as U05
    usecase "UC-06 Sit\nlocked exam" as U06
    usecase "UC-07 Send\nmonitoring data" as U07
    usecase "UC-08 Autosave and\nsubmit answers" as U08
  }
  rectangle "Web panel" as WEB {
    usecase "UC-09 View\nstudent evidence" as U09
    usecase "UC-10 Supervise\nexam live" as U10
    usecase "UC-11 Take action\non a student" as U11
    usecase "UC-12 Web\nsign-in" as U12
    usecase "UC-14 View\nresults" as U13
  }
}

' web panel in a second column
U04 -[hidden]- U10

' include: base -> included; extend: extension -> base
U05 .left.> U06 : <<extend>>
U06 .left.> U07 : <<include>>
U09 .left.> U10 : <<extend>>
U11 .right.> U10 : <<extend>>

STU -- U01
STU -- U02
STU -- U03
STU -- U04
STU -- U06
STU -- U08
STU -- U12
STU -- U13

U10 -- INV
U12 -- INV

@enduml

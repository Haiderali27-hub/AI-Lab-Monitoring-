@startuml
' UML 2.5 use case diagram. Subject = SmartExam (two subsystems); actors outside.
' Every use case carries its ID (UC-nn, as in the Chapter 4 description tables) and its FR.
' Drawn as two figures: (a) this file: the student's use cases and live supervision;
' (b) use_case_diagram_b.puml: the staff use cases of the web panel (Teacher, Admin, SuperAdmin).
!include style.iuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 8
skinparam ranksep 34
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam usecase {
  FontSize 14
}
skinparam actor {
  FontSize 14
}
skinparam rectangle {
  FontSize 14
}

actor "Student" as STU
actor "Invigilator" as INV

rectangle "SmartExam" {
  rectangle "Student desktop client (WPF)" as DESK {
    usecase "UC-01 Log in and\nbind device (FR1)" as U01
    usecase "UC-02 Run readiness\ncheck (FR2)" as U02
    usecase "UC-03 Take practice\nexam (FR2)" as U03
    usecase "UC-04 View assigned exam,\ncheck in and start (FR3, FR9)" as U04
    usecase "UC-05 Receive warning,\nextra time or unlock (FR10)" as U05
    usecase "UC-06 Sit locked\nexam (FR4)" as U06
    usecase "UC-07 Send heartbeats,\nevents, screenshots (FR5)" as U07
    usecase "UC-08 Autosave and\nsubmit answers (FR6)" as U08
  }
  rectangle "Web panel (React)" as WEB {
    usecase "UC-09 View timeline, screenshots\nand webcam snapshots (FR10)" as U09
    usecase "UC-10 Supervise exam\nlive (FR10)" as U10
    usecase "UC-11 Warn, extend time, unlock,\nforce-submit, log incident (FR10)" as U11
    usecase "UC-12 Sign in, change\npassword, sign out (FR1)" as U12
    usecase "UC-14 View results, violations,\nperformance, notifications (FR3)" as U13
  }
}

' web panel in a second column
U04 -[hidden]- U10

' include: base -> included; extend: extension -> base
U05 .left.> U06 : <<extend>>
U06 .left.> U07 : <<include>>
U09 .left.> U10 : <<extend>>
U11 .right.> U10 : <<extend>>

STU -- U01
STU -- U02
STU -- U03
STU -- U04
STU -- U06
STU -- U08
STU -- U12
STU -- U13

U10 -- INV
U12 -- INV

@enduml

@startuml
!include style.iuml
' DFD level 1, part (b): processes 4.0 and 5.0 (live proctoring, evaluation
' and reporting). Part (a) is dfd_level_1.puml (1.0-3.0). Same notation:
' circle = process, rectangle = external entity, two lines = data store,
' two-headed arrow = read and update, dashed circle = process of part (a),
' dashed rectangle = optional entity, * = entity drawn twice.
skinparam defaultFontSize 16
skinparam ArrowFontSize 16
skinparam nodesep 14
skinparam ranksep 34
skinparam defaultTextAlignment center
skinparam rectangle<<entity>> {
  BorderThickness 2
  RoundCorner 0
  BackgroundColor #FFFFFF
}
skinparam rectangle<<optional>> {
  RoundCorner 0
  BorderStyle dashed
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BorderColor #333333
  BorderThickness 2
  BackgroundColor #F2F2F2
}
skinparam usecase<<ref>> {
  BorderStyle dashed
  BorderThickness 1
  BackgroundColor #FFFFFF
}
skinparam label {
  FontSize 16
}
hide stereotype

rectangle "Teacher" <<entity>> as TEA
rectangle "Invigilator" <<entity>> as INV
rectangle "Teacher *" <<entity>> as TEA2
rectangle "Admin /\nSuperAdmin" <<entity>> as ADM
rectangle "Student" <<entity>> as STU
rectangle "LLM grader\n(optional, off)" <<optional>> as LLM

usecase "**3.0**\nLockdown and\ntelemetry (part a)" <<ref>> as P3
usecase "**2.0**\nConfigure exams and\nrun sessions (part a)" <<ref>> as P2
usecase "**4.0**\nLive\nproctoring" as P4
usecase "**5.0**\nEvaluation\nand reporting" as P5

label D2 [
----
**D2** Exams, Questions,
TestCases
----
]
label D3 [
----
**D3** Departments,
Courses, Sections,
SectionEnrollments,
Labs, Workstations,
AttendanceRecords,
ExamAssignments,
ExamProctors
----
]
label D4 [
----
**D4** ExamSessions,
Answers, ReadinessChecks
----
]
label D5 [
----
**D5** MonitoringEvents,
Screenshots, Incidents
----
]
label D6 [
----
**D6** AiGradingResults,
TestCaseResults,
PlagiarismResults,
TeacherGradeOverrides,
ExamReports
----
]
label D7 [
----
**D7** Notifications
----
]
label D8 [
----
**D8** AuditLogs
----
]

' ---- row 0: staff and 3.0; row 1: 4.0; row 2: stores; row 3: 5.0; row 4: entities of 5.0
TEA --> P4 : warn, extend,\nunlock,\nforce-submit,\nincident
TEA <-- P4 : live status\n(SignalR); timeline,\nscreenshots (REST)
INV --> P4 : warn, extend,\nunlock,\nforce-submit,\nincident
INV <-- P4 : live status\n(SignalR); timeline,\nscreenshots (REST)
P3 --> P4 : heartbeats, classed\nevents, alerts

' ---- 4.0 and the stores (stores below 4.0, above 5.0)
P4 <-- D3 : ExamProctors
P4 --> D4 : extra time, unlock,\nforce-submit
P4 <-- D5 : timeline,\nscreenshots
P4 --> D5 : incidents
P4 --> D7 : warnings
P4 --> D8 : staff actions

' ---- 5.0
P2 --> P5 : submitted session
D2 --> P5 : questions, test\ncases, model answers
D3 --> P5 : attendance,\neligibility
D4 --> P5 : submitted answers,\nsessions
D5 --> P5 : violations, evidence
D7 --> P5 : notifications
D8 --> P5 : audit entries, hash\nchain
D8 <-- P5 : grading and report\nevents
P5 --> D6 : marks, pairs,\noverrides, reports
P5 <-- D6 : marks
P5 --> TEA2 : suggested marks,\nsimilarity matrix,\nPDF / Excel /\nevidence-ZIP reports
P5 <-- TEA2 : accept / override,\nreport request
P5 --> ADM : audit log and chain\nstatus, system\nanalytics
P5 --> STU : results, violation\nhistory,\nperformance,\nnotifications
P5 ..> LLM : theory answer, model\nanswer, rubric\nkeywords; code test\nresults
P5 <.. LLM : suggested mark, code\nsummary
@enduml

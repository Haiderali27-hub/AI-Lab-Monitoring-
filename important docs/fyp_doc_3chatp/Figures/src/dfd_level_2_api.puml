@startuml
!include style.iuml
' Part (b): the API processes 3.3-3.5; 3.1 and 3.2 are in dfd_level_2.puml (part a).
' DFD level 2 of process 3.0 (Lockdown and telemetry). Process 5.0 is in
' dfd_level_2b.puml. Same entities, numbers and stores (D1..D8) as level 1.
' Yourdon/DeMarco notation: circle = process, rectangle = external entity,
' two lines = data store, two-headed arrow = read and update,
' dashed circle = level-1 process outside 3.0, * = store drawn twice.
' 3.1 and 3.2 run in the WPF client on the lab PC; 3.3-3.5 run in the API.
skinparam defaultFontSize 16
skinparam ArrowFontSize 16
skinparam nodesep 16
skinparam ranksep 40
skinparam defaultTextAlignment center
skinparam rectangle<<entity>> {
  BorderThickness 2
  RoundCorner 0
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BorderColor #333333
  BorderThickness 2
  BackgroundColor #F2F2F2
}
skinparam usecase<<ref>> {
  BorderStyle dashed
  BorderThickness 1
  BackgroundColor #FFFFFF
}
skinparam label {
  FontSize 16
}
hide stereotype
top to bottom direction

usecase "**3.2**\nMonitor and send\n(client, part a)" <<ref>> as P32
label D3 [
----
**D3** Academic and
lab data
----
]
label D4 [
----
**D4** Sessions and
answers
----
]
label D7 [
----
**D7** Notifications
----
]
usecase "**3.3**\nReceive telemetry" as P33
usecase "**3.4**\nRecord heartbeat,\nwatch liveness" as P34
usecase "**3.5**\nClassify and\nsave events" as P35
label D4b [
----
**D4 *** Sessions
and answers
----
]
label D1 [
----
**D1** Identity
----
]
label D5b [
----
**D5 *** Monitoring
evidence
----
]
label D8b [
----
**D8 *** Audit log
----
]
label D5 [
----
**D5** Monitoring
evidence
----
]
label D8 [
----
**D8** Audit log
----
]
usecase "**4.0**\nLive\nproctoring" <<ref>> as P4

' ---- rank 0: 3.2 and the stores 3.3 reads; rank 1: 3.3; rank 2: 3.4, 3.5 and
' ---- D1 beside 3.4 (one-dash arrow, same rank; keeps the PNG narrow enough for
' ---- 6.5 pt printed text); rank 3: stores written (3.4 on the left, 3.3 and 3.5
' ---- on the right); rank 4: 4.0. "X <-- P" keeps X above P. * = store drawn twice.
' ---- Short labels; the chapter text gives the message and audit names.
P32 --> P33 : heartbeat,\nevents, images
P32 <-- P33 : reply: warnings,\nextra time, unlock
D3 --> P33 : assigned\nseat
D4 --> P33 : extra time,\nunlock
D7 --> P33 : warnings
P33 --> P34 : heartbeat
P33 --> P35 : events
P33 --> D5 : images,\nseat mismatch
P33 --> D8 : seat\nmismatch
P33 --> P4 : screenshot,\nseat alerts

P34 <--> D4b : heartbeat\nstatus
D1 <- P34 : last seen
P34 <-- D5b : violations
P34 --> D5b : heartbeat,\ndisconnect
P34 --> D8b : disconnect,\nreconnect
P34 --> P4 : heartbeat,\nconnection

P35 --> D5 : new events
P35 --> D8 : violations
P35 --> P4 : violations

D5b -[hidden]-> P4
D5 -[hidden]-> P4
@enduml

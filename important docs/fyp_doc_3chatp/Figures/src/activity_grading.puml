@startuml
!include style.iuml
' AI-assisted grading (Module 11): SubmissionService.FinalizeAsync -> GradingService.StageAsync (when
' AiEvaluationEnabled): graded at once = MCQ key, TheoryGrader TF-IDF (LLM off), blank code (0, High),
' Grading:Runner = None (SetNotRun: 0, Low, CodeAnalyzer); otherwise a Pending row (coding: plus Pending test-case
' rows) that is queued; PlagiarismService.DetectAsync (PlagiarismEngine winnowing) unless IsMock; SaveChanges, then
' GradingQueue.Enqueue. GradingWorker (Grading:MaxParallel = 2 consumers, re-queues Pending rows on start) ->
' GradingService.ProcessAsync: Theory -> LlmGrader (TheoryGrader fallback); Coding -> CodeRunnerResolver
' (DockerCodeRunner gcc:13 or LocalMingwCodeRunner); no runner / not C or C++ -> SetNotRun; runner throws MaxAttempts
' = 3 times -> Failed; compile error -> 0, High (TestCaseScorer); else OutputComparer + TestCaseScorer; CodeAnalyzer on
' every coding path; audit AI_GRADING_COMPLETED / AI_GRADING_FAILED; hub GradingCompleted.
' Teacher, concurrently: POST /api/exams/{id}/grading/accept-ai (skips NeedsManualMark rows; Pending/Failed = notReady;
' audit AI_SUGGESTIONS_ACCEPTED), POST /api/answers/{id}/override (GRADE_OVERRIDDEN),
' POST /api/answers/{id}/regrade (AI_REGRADE_REQUESTED, back to the queue).
' Printed pt = fontSize * 72 * printed_width_in / png_width_px.
skinparam dpi 96
skinparam defaultFontSize 28
skinparam ArrowFontSize 27
skinparam padding 1
skinparam swimlane {
  BorderColor #777777
  TitleFontSize 29
}
|Server (API and GradingWorker)|
start
:SubmissionService.FinalizeAsync:
session Submitted, ForceSubmitted
or TimedOut, SHA-256 receipt;
if (AiEvaluationEnabled?) then ([yes])
  if (StageAsync: answer\ngraded at once?) then ([yes])
    :MCQ: key. Theory (LLM off):
    TF-IDF, 0.7 x cosine + 0.3 x
    key-term coverage. Blank code:
    0, High. Runner = None: not
    run, 0, Low, CodeAnalyzer;
  else ([no])
    :Pending
    row, queued
    (coding: and
    test-case
    rows);
  endif
else ([no])
endif
if (Practice exam?) then ([no])
  :PlagiarismService: k-gram
  winnowing (k = 5, w = 4),
  pairs >= threshold;
else ([yes])
endif
:SaveChanges, then enqueue
the queued answers;
fork
  while (GradingWorker:\nanswer queued?) is ([yes])
    if (Type?) then ([Theory])
      :LLM grader
      (TheoryGrader
      fallback);
    else ([Coding])
      if (Runner found\nand C/C++?) then ([no])
        :Not run:
        0, Low;
      else ([yes])
        :Compile, run each
        test case: Docker
        gcc:13 (no network,
        memory, CPU, time
        limits) or MinGW
        g++ (not isolated),
        up to 3 attempts;
        switch (Result?)
        case ([failed])
          :Failed,
          0, Low;
        case ([compile\nerror])
          :0, High,
          compiler
          output;
        case ([ran])
          :OutputComparer,
          TestCaseScorer;
        endswitch
      endif
      :CodeAnalyzer (loops,
      recursion, hard-coding);
    endif
    :Save AiGradingResult,
    TestCaseResults, audit
    AI_GRADING_COMPLETED
    (or _FAILED), hub
    GradingCompleted;
  endwhile ([no])
fork again
  |Teacher (ResultsPage)|
  repeat
    :Review AI
    suggestions,
    test cases,
    plagiarism
    heat map;
    if (Action?) then ([accept\nall])
      :accept-ai: Graded
      rows with a real
      suggestion
      (Pending/Failed:
      notReady, not run
      or compile-only:
      needsManualMark),
      audit
      AI_SUGGESTIONS_
      ACCEPTED;
    else ([one\nanswer])
      :override
      (GRADE_
      OVERRIDDEN)
      or regrade
      (queued,
      AI_REGRADE_
      REQUESTED);
    endif
  repeat while (More to\nreview?) is ([yes]) not ([no])
end fork
stop
@enduml

@startuml
!include style.iuml
' Allowed applications: CreateExamPage + AllowedAppsPicker (utils/allowedApps.ts), ExamsController POST/PUT
' (Exam.AllowedApps JSON, Exam.LockdownMode, default Report), GET /api/exams/student/current (practice exam: Report,
' no list), LockdownCoordinator (Start does nothing when Mode = Off), LockdownPolicy.Evaluate, ProcessGuardService
' (2 s scan, own Windows session; Enforce kills every time, Report raises once per app via _reported),
' LockdownCoordinator.Report (drops a repeat of the same reason|detail within ReportCooldown = 15 s) ->
' LiveMonitoringService.ReportViolation (urgent event in the encrypted outbox + CaptureForViolation).
' Printed pt = fontSize * 72 * printed_width_in / png_width_px.
skinparam dpi 96
skinparam defaultFontSize 28
skinparam ArrowFontSize 27
skinparam padding 1
skinparam swimlane {
  BorderColor #777777
  TitleFontSize 29
}

|Teacher (Web Panel)|
start
repeat
  :Pick a catalogue app
  or type an .exe name
  (AllowedAppsPicker);
repeat while (Valid exe\nname?) is ([no]) not ([yes])
:Choose LockdownMode:
Off, Report (default)
or Enforce; POST / PUT
/api/exams;
|Server|
:ExamsController
saves AllowedApps
(JSON list) and
LockdownMode on
the Exam;
|Desktop App|
:GET /api/exams/student/current returns
allowedApps and lockdownMode (practice exam:
Report, no list); the exam window's
LockdownCoordinator builds LockdownPolicy;
if (Mode = Off?) then ([yes: no guards])
  stop
else ([no])
endif
repeat
  :ProcessGuardService scans every 2 s (own Windows
  session); allows own app, AllowedApps, shell processes
  and windowless apps (not browsers, remote tools,
  Task Manager);
  if (Unauthorised app found?) then ([yes])
    if (Mode?) then ([Enforce])
      :Kill the process tree: ProcessKilled
      (kill failed: UnauthorizedProcess);
    else ([Report])
    endif
    if (Enforce, or app not\nyet reported?) then ([yes])
      :LockdownCoordinator.Report (same reason
      and app within 15 s dropped): urgent Violation
      to the encrypted outbox, capture the screen;
    else ([no])
    endif
  else ([no])
  endif
repeat while (Session running?) is ([yes]) not ([no])
:Stop all guards;
stop
@enduml

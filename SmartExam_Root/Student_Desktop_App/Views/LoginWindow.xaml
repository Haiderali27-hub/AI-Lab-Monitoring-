<Window x:Class="Student_Desktop_App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartExam Secure Authentication"
        Height="620"
        Width="460"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">
    <Border CornerRadius="18" Background="White" Margin="16" BorderBrush="#E6EBF3" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" Opacity="0.20" ShadowDepth="0" Color="#1B2A4A" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar (drag + window controls) ===== -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Secure Student Client" FontSize="11" FontWeight="SemiBold"
                           Foreground="#94A3B8" VerticalAlignment="Center" Margin="18,0,0,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimize" />
                    <Button Style="{StaticResource CloseBarButton}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ===== Content ===== -->
            <StackPanel Grid.Row="1" Margin="34,6,34,28" VerticalAlignment="Center">

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Border Width="52" Height="52" CornerRadius="15" Background="{StaticResource PrimaryGrad}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Opacity="0.35" ShadowDepth="0" Color="#2563EB" />
                        </Border.Effect>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SmartExam" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="AI-Driven Lab Exam Monitoring" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="WELCOME BACK" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="2,4,0,2" />
                <TextBlock Text="Sign in to your account" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,20" />

                <TextBlock Text="EMAIL OR USERNAME" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,0,0,6" />
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding UsernameOrEmail, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="PASSWORD" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,16,0,6" />
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource ModernPasswordBox}" />

                <Border Background="#F1F6FF" CornerRadius="11" Padding="13,10" Margin="0,18,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Primary}" VerticalAlignment="Center" />
                        <TextBlock Text="This device will be securely bound to your account." FontSize="11.5"
                                   Foreground="#3B5573" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Content="Sign In" Click="LoginButton_OnClick" />

                <Border Background="#F8FAFC" CornerRadius="10" Padding="12,10" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,4,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
